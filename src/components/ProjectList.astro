---
import type { WorkProject } from '../data/work';

interface Props {
  projects: WorkProject[];
}

const { projects } = Astro.props;
---

<ul class="projects">
  {
    projects.map((project, i) => (
      <li class="project card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
        <div class="project__media">
          {project.image ? (
            <img
              class="project__image"
              src={project.image}
              alt=""
              width="200"
              height="240"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="project__media-fallback" aria-hidden="true" />
          )}
        </div>
        <div class="project__body">
          <div class="project__meta">
            <span class="tag">{project.period}</span>
            <span class="project__role">{project.role}</span>
          </div>
          <h3 class="project__title">
            {project.href ? <a href={project.href}>{project.title}</a> : project.title}
          </h3>
          <p class="project__summary">{project.summary}</p>
          <ul class="project__outcomes">
            {project.outcomes.map((outcome) => (
              <li>
                <span class="project__bullet" aria-hidden="true">
                  ◦
                </span>
                <span>{outcome}</span>
              </li>
            ))}
          </ul>
          <ul class="project__tags">
            {project.tags.map((tag) => {
              const isExternal = Boolean(tag.href && /^https?:\/\//.test(tag.href));
              return (
                <li>
                  {tag.href ? (
                    <a
                      class="project__chip"
                      href={tag.href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                    >
                      {tag.label}
                    </a>
                  ) : (
                    <span class="project__chip">{tag.label}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-24);
  }

  .project {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--spacing-24);
    align-items: start;
    background: var(--surface-limestone);
    color: var(--color-obsidian);
  }

  .project__media {
    width: 200px;
    height: 240px;
    flex-shrink: 0;
    border-radius: var(--radius-medium);
    overflow: hidden;
  }

  .project__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project__media-fallback {
    width: 100%;
    height: 100%;
    background: var(--surface-pumice-canvas);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-10);
    margin-bottom: var(--spacing-16);
  }

  .project__role {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-body-sm);
    opacity: 0.72;
  }

  .project__title {
    margin: 0 0 var(--spacing-12);
    font-size: clamp(var(--text-subheading), 3.2vw, var(--text-heading-sm));
    line-height: var(--leading-subheading);
    letter-spacing: var(--tracking-heading);
    text-transform: none;
  }

  .project__title a {
    color: inherit;
    text-decoration: none;
  }

  .project__title a:hover {
    color: var(--color-ember);
  }

  .project__summary {
    margin: 0 0 var(--spacing-20);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-body);
    opacity: 0.8;
  }

  .project__outcomes {
    list-style: none;
    margin: 0 0 var(--spacing-24);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
    font-size: var(--text-body-sm);
    font-weight: 300;
    line-height: 1.45;
  }

  .project__outcomes li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-10);
  }

  .project__bullet {
    flex-shrink: 0;
  }

  .project__tags {
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-10);
  }

  .project__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: var(--radius-pills);
    border: 1.5px solid color-mix(in srgb, var(--color-obsidian) 55%, transparent);
    background: transparent;
    color: inherit;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  a.project__chip {
    cursor: pointer;
  }

  .project__chip:hover {
    background: var(--color-obsidian);
    border-color: var(--color-obsidian);
    color: var(--color-chalk);
  }

  @media (max-width: 640px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project__media {
      width: 100%;
      height: auto;
      aspect-ratio: 200 / 240;
    }
  }
</style>
