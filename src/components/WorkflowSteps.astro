---
import type { Workflow } from '../data/workflow';
import WorkflowLayersPanel from './WorkflowLayersPanel.astro';

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
const pair = workflow.steps.filter((s) => !s.fullWidth);
const full = workflow.steps.filter((s) => s.fullWidth);
---

<div class="workflow">
  <div class="workflow__pair">
    {
      pair.map((step, i) => (
        <article
          class:list={['workflow__card', `workflow__card--${step.variant}`]}
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="workflow__card-body">
            <div class="workflow__card-head">
              <p class="workflow__label">{step.label}</p>
              <h3 class="workflow__title">{step.title}</h3>
            </div>
            {step.learnings && step.learnings.length > 0 && (
              <div class="workflow__learnings">
                <p class="workflow__learnings-title">Learning:</p>
                <ul class="workflow__list">
                  {step.learnings.map((item) => (
                    <li>
                      <span class="workflow__bullet" aria-hidden="true">
                        ◦
                      </span>
                      <span class="workflow__learning-text">{item.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          {step.cta && (
            <div class="workflow__card-foot">
              {step.cta.panel ? (
                <button
                  type="button"
                  class="workflow__cta"
                  data-workflow-panel={step.cta.panel}
                  aria-haspopup="dialog"
                  aria-controls={`panel-${step.cta.panel}`}
                >
                  {step.cta.label}
                </button>
              ) : step.cta.href ? (
                <a
                  class="workflow__cta"
                  href={step.cta.href}
                  target={/^https?:\/\//.test(step.cta.href) ? '_blank' : undefined}
                  rel={/^https?:\/\//.test(step.cta.href) ? 'noopener noreferrer' : undefined}
                >
                  {step.cta.label}
                </a>
              ) : (
                <span class="workflow__cta">{step.cta.label}</span>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>

  {
    full.map((step, i) => (
      <article
        class:list={['workflow__card', 'workflow__card--full', `workflow__card--${step.variant}`]}
        data-reveal
        style={`--reveal-delay: ${(pair.length + i) * 90}ms`}
      >
        <div class="workflow__card-body">
          <div class="workflow__card-head">
            <p class="workflow__label">{step.label}</p>
            <h3 class="workflow__title">{step.title}</h3>
          </div>
        </div>
        {step.cta && (
          <div class="workflow__card-foot">
            {step.cta.panel ? (
              <button
                type="button"
                class="workflow__cta"
                data-workflow-panel={step.cta.panel}
                aria-haspopup="dialog"
                aria-controls={`panel-${step.cta.panel}`}
              >
                {step.cta.label}
              </button>
            ) : step.cta.href ? (
              <a
                class="workflow__cta"
                href={step.cta.href}
                target={/^https?:\/\//.test(step.cta.href) ? '_blank' : undefined}
                rel={/^https?:\/\//.test(step.cta.href) ? 'noopener noreferrer' : undefined}
              >
                {step.cta.label}
              </a>
            ) : (
              <span class="workflow__cta">{step.cta.label}</span>
            )}
          </div>
        )}
      </article>
    ))
  }
</div>

<WorkflowLayersPanel />

<style>
  .workflow {
    display: grid;
    gap: var(--spacing-16);
    width: 100%;
  }

  .workflow__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-16);
    align-items: stretch;
  }

  .workflow__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-32);
    min-height: 280px;
    padding: var(--spacing-32);
    border-radius: 32px;
  }

  .workflow__card--chalk {
    background: var(--color-chalk);
    color: var(--color-obsidian);
  }

  .workflow__card--plasma {
    background: var(--color-plasma-violet);
    color: var(--color-chalk);
  }

  .workflow__card--ember {
    background: var(--color-ember);
    color: var(--color-chalk);
    min-height: 0;
    gap: var(--spacing-40);
  }

  .workflow__card-body {
    display: grid;
    gap: var(--spacing-24);
    min-width: 0;
  }

  .workflow__card-head {
    display: grid;
    gap: var(--spacing-8);
  }

  .workflow__label {
    margin: 0;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-caption);
    opacity: 0.55;
  }

  .workflow__card--plasma .workflow__label,
  .workflow__card--ember .workflow__label {
    opacity: 0.72;
  }

  .workflow__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-subheading);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-subheading);
    letter-spacing: 0.01em;
    text-transform: none;
    color: inherit;
  }

  .workflow__learnings {
    display: grid;
    gap: var(--spacing-4);
  }

  .workflow__learnings-title {
    margin: 0;
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.55;
    opacity: 0.55;
  }

  .workflow__card--plasma .workflow__learnings-title {
    opacity: 0.72;
  }

  .workflow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-4);
  }

  .workflow__list li {
    display: flex;
    gap: var(--spacing-8);
    align-items: flex-start;
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.55;
    opacity: 0.72;
  }

  .workflow__card--plasma .workflow__list li {
    opacity: 0.92;
  }

  .workflow__bullet {
    flex-shrink: 0;
  }

  .workflow__learning-text {
    min-width: 0;
  }

  .workflow__card-foot {
    display: flex;
    justify-content: flex-end;
  }

  .workflow__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 10px 18px;
    border-radius: var(--radius-pills);
    border: 1.5px solid currentColor;
    background: transparent;
    color: inherit;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: default;
  }

  a.workflow__cta,
  button.workflow__cta {
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  a.workflow__cta:hover,
  button.workflow__cta:hover {
    background: var(--color-obsidian);
    border-color: var(--color-obsidian);
    color: var(--color-chalk);
  }

  .workflow__card--plasma a.workflow__cta:hover,
  .workflow__card--plasma button.workflow__cta:hover {
    background: var(--color-chalk);
    border-color: var(--color-chalk);
    color: var(--color-plasma-violet);
  }

  .workflow__card--ember a.workflow__cta:hover,
  .workflow__card--ember button.workflow__cta:hover {
    background: var(--color-chalk);
    border-color: var(--color-chalk);
    color: var(--color-ember);
  }

  .workflow__card--chalk .workflow__cta {
    border-color: color-mix(in srgb, var(--color-obsidian) 55%, transparent);
  }

  @media (max-width: 720px) {
    .workflow__pair {
      grid-template-columns: 1fr;
    }

    .workflow__card {
      min-height: 0;
      padding: var(--spacing-24);
      border-radius: var(--radius-medium);
    }

    .workflow__cta {
      white-space: normal;
      text-align: center;
    }
  }
</style>
