---
import { contactSection } from '../data/contact';
import { withBase } from '../lib/paths';

const { mode, lark, channels } = contactSection;
const avatarSrc = withBase('/chen-avatar-contact.png');
---

{
  mode === 'lark' ? (
    <a
      class="contact-pill"
      href={lark.profileUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="contact-pill__avatar"
        src={avatarSrc}
        alt=""
        width="28"
        height="28"
        decoding="async"
      />
      <span class="contact-pill__name">{lark.name}</span>
    </a>
  ) : (
    <div class="contact-copy" data-contact-copy>
      {channels.map((channel) => (
        <div class="contact-copy__item">
          <div class="contact-copy__text">
            <span class="contact-copy__label">{channel.label}</span>
            <span class="contact-copy__value">{channel.value}</span>
          </div>
          <button
            type="button"
            class="contact-copy__icon-btn"
            data-copy-value={channel.value}
            aria-label={`复制${channel.label} ${channel.value}`}
          >
            <svg
              class="contact-copy__icon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
            >
              <rect
                x="9"
                y="9"
                width="11"
                height="11"
                rx="2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              />
              <path
                d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      ))}
      <div class="contact-toast" data-contact-toast role="status" aria-live="polite" aria-hidden="true">
        已复制
      </div>
    </div>
  )
}

{
  mode === 'copy' && (
    <script>
      function bindContactCopy() {
        const root = document.querySelector('[data-contact-copy]');
        if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') return;
        root.dataset.bound = 'true';

        const toast = root.querySelector('[data-contact-toast]');
        let toastTimer = 0;
        let hideTimer = 0;

        const showToast = (message: string) => {
          if (!(toast instanceof HTMLElement)) return;
          toast.textContent = message;
          toast.setAttribute('aria-hidden', 'false');
          toast.classList.add('is-visible');
          window.clearTimeout(toastTimer);
          window.clearTimeout(hideTimer);
          toastTimer = window.setTimeout(() => {
            toast.classList.remove('is-visible');
            hideTimer = window.setTimeout(() => {
              toast.setAttribute('aria-hidden', 'true');
            }, 200);
          }, 1600);
        };

        root.querySelectorAll('[data-copy-value]').forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          node.addEventListener('click', async () => {
            const value = node.dataset.copyValue;
            if (!value) return;
            try {
              await navigator.clipboard.writeText(value);
              showToast('已复制');
            } catch {
              showToast('复制失败');
            }
          });
        });
      }

      bindContactCopy();
      document.addEventListener('astro:page-load', bindContactCopy);
    </script>
  )
}

<style>
  .contact-pill {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    width: fit-content;
    padding: 8px 18px 8px 10px;
    background: color-mix(in srgb, var(--color-chalk) 40%, transparent);
    border-radius: var(--radius-pills);
    text-decoration: none;
    color: var(--color-chalk);
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .contact-pill:hover {
    opacity: 0.92;
    color: var(--color-chalk);
  }

  .contact-pill__avatar {
    display: block;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 100px;
    object-fit: cover;
  }

  .contact-pill__name {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-chalk);
  }

  .contact-copy {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-12);
  }

  .contact-copy__item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-12);
    min-width: 220px;
    padding: 12px 14px 12px 20px;
    border: 1px solid color-mix(in srgb, var(--color-chalk) 28%, transparent);
    border-radius: var(--radius-pills);
    background: color-mix(in srgb, var(--color-chalk) 12%, transparent);
    color: var(--color-chalk);
  }

  .contact-copy__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .contact-copy__label {
    font-family: var(--font-caption);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    opacity: 0.7;
  }

  .contact-copy__value {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    word-break: break-all;
  }

  .contact-copy__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-chalk) 16%, transparent);
    color: var(--color-chalk);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  .contact-copy__icon-btn:hover {
    background: color-mix(in srgb, var(--color-chalk) 28%, transparent);
  }

  .contact-copy__icon-btn:focus-visible {
    outline: 2px solid var(--color-ember);
    outline-offset: 2px;
  }

  .contact-copy__icon {
    display: block;
  }

  .contact-toast {
    position: fixed;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom, 0px));
    z-index: 80;
    padding: 10px 18px;
    border-radius: var(--radius-pills);
    border: 1px solid color-mix(in srgb, var(--color-chalk) 22%, transparent);
    background: color-mix(in srgb, var(--color-obsidian) 72%, transparent);
    color: var(--color-chalk);
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--color-obsidian) 40%, transparent);
    pointer-events: none;
    transform: translate(-50%, 8px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
  }

  .contact-toast.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-copy__icon-btn,
    .contact-toast {
      transition: none;
    }
  }
</style>
