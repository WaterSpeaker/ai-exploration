---
import type { VibeProject } from '../data/vibe';

interface Props {
  projects: VibeProject[];
}

const { projects } = Astro.props;
---

<ul class="vibe">
  {
    projects.map((project, i) => {
      const isExternal = Boolean(project.href && /^https?:\/\//.test(project.href));
      const cardInner = (
        <>
          <div class="vibe__media">
            {project.image ? (
              <img
                class="vibe__image"
                src={project.image}
                alt=""
                width="348"
                height="182"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="vibe__media-fallback" aria-hidden="true" />
            )}
          </div>
          <div class="vibe__body">
            <h3 class="vibe__name">{project.name}</h3>
            <p class="vibe__blurb">{project.blurb}</p>
            <p class="vibe__stack">{project.stack.join(' · ')}</p>
          </div>
        </>
      );

      return (
        <li class="vibe__item" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
          {project.href ? (
            <a
              class="vibe__card"
              href={project.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              {cardInner}
            </a>
          ) : (
            <div class="vibe__card">{cardInner}</div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .vibe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-24);
  }

  .vibe__item {
    min-width: 0;
  }

  .vibe__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spacing-16);
    background: var(--color-chalk);
    border-radius: var(--radius-cards);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out);
  }

  a.vibe__card {
    cursor: pointer;
  }

  a.vibe__card:hover {
    color: inherit;
    transform: translateY(-3px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-obsidian) 10%, transparent);
  }

  a.vibe__card:focus-visible {
    outline: 2px solid var(--color-ember);
    outline-offset: 3px;
  }

  .vibe__media {
    position: relative;
    width: 100%;
    aspect-ratio: 348 / 182;
    overflow: hidden;
    border-radius: 32px;
    background: var(--color-chalk);
    flex-shrink: 0;
  }

  .vibe__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Avoid dark fringe from subpixel AA against rounded clip */
    transform: translateZ(0);
  }

  .vibe__media-fallback {
    width: 100%;
    height: 100%;
    background: var(--color-chalk);
  }

  .vibe__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
    padding: var(--spacing-32) clamp(var(--spacing-16), 4.5%, var(--spacing-24))
      var(--spacing-16);
    flex: 1;
    min-width: 0;
  }

  .vibe__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vibe__blurb {
    margin: 0;
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 300;
    line-height: 21.7px;
    color: var(--color-obsidian);
  }

  .vibe__stack {
    margin: 0;
    font-family: var(--font-caption);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: 18.6px;
    color: var(--color-ember);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 960px) {
    .vibe {
      grid-template-columns: 1fr;
    }

    .vibe__body {
      padding: var(--spacing-32) var(--spacing-24) var(--spacing-16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vibe__card,
    a.vibe__card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
