---
import { portfolioItems } from '../data/portfolios';
---

<div class="portfolios">
  {
    portfolioItems.map((item, i) => (
      <a
        class="portfolios__card"
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        style={i ? `--reveal-delay: ${i * 90}ms` : undefined}
      >
        <img
          class="portfolios__cover"
          src={item.image}
          alt={item.alt}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </a>
    ))
  }
</div>

<style>
  .portfolios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-32);
    align-items: start;
  }

  .portfolios__card {
    position: relative;
    display: block;
    width: 100%;
    height: 0;
    padding-top: calc(100% * 9 / 16);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-cards);
    background: var(--surface-limestone);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .portfolios__card:hover {
    opacity: 0.92;
    color: inherit;
  }

  .portfolios__cover {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-cards);
  }

  @media (max-width: 720px) {
    .portfolios {
      grid-template-columns: 1fr;
    }
  }
</style>
