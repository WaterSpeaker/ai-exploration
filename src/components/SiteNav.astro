---
import { withBase } from '../lib/paths';

interface Props {
  /** Which top-nav page is current. */
  active?: 'home' | 'labs';
}

const { active = 'home' } = Astro.props;
const homeHref = withBase('/');
const labsHref = withBase('/ai-labs');

type NavLink = {
  label: string;
  href: string;
  page: 'home' | 'labs';
};

const navLinks: NavLink[] = [
  { label: 'Intro', href: homeHref, page: 'home' },
  { label: 'AI Labs', href: labsHref, page: 'labs' },
];
---

<header class="site-nav">
  <div class="site-nav__bar site-shell">
    <a class="site-nav__brand" href={homeHref}>
      <span class="site-nav__mark" aria-hidden="true"></span>
      <span class="site-nav__brand-text">Chen’s AI Exploration</span>
    </a>

    <nav class="site-nav__links" aria-label="主导航">
      {
        navLinks.map((link) => {
          const isActive = link.page === active;
          return (
            <a
              class:list={['site-nav__link', { 'is-active': isActive }]}
              href={link.href}
              aria-current={isActive ? 'true' : undefined}
            >
              <span class="site-nav__link-label">{link.label}</span>
            </a>
          );
        })
      }
    </nav>

    <a class="site-nav__cta" href={`${homeHref}#contact`}>Contact me</a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: var(--spacing-16) 0;
    background: var(--surface-pumice-canvas);
  }

  .site-nav__bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    background: var(--surface-limestone);
    border-radius: var(--radius-pills);
    padding: 9px 12px 9px 20px;
    font-family: 'PP Neue Corp Compact', var(--font-body);
    font-synthesis: none;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--color-ember);
  }

  .site-nav__brand:hover {
    color: var(--color-ember);
    opacity: 0.92;
  }

  .site-nav__mark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-ember);
    flex-shrink: 0;
  }

  .site-nav__brand-text {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
  }

  .site-nav__links {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: var(--radius-pills);
    text-decoration: none;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-obsidian);
  }

  .site-nav__link:hover {
    color: var(--color-ember);
  }

  .site-nav__link-label {
    position: relative;
    display: inline-block;
  }

  .site-nav__link.is-active .site-nav__link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-ember);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    gap: 8px;
    padding: 12px 24px;
    border-radius: var(--radius-pills);
    background: var(--color-ember);
    color: var(--color-chalk);
    text-decoration: none;
    white-space: nowrap;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }

  .site-nav__cta:hover {
    color: var(--color-chalk);
    opacity: 0.92;
  }

  @media (max-width: 900px) {
    .site-nav__links {
      display: none;
    }

    .site-nav__bar {
      justify-content: space-between;
    }
  }
</style>
