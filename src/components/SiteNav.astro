---
import { withBase } from '../lib/paths';

interface Props {
  /** Use absolute `/#section` links (needed on secondary pages). */
  homeAnchors?: boolean;
}

const { homeAnchors = false } = Astro.props;
const homeHref = withBase('/');
const prefix = homeAnchors ? homeHref : '';

const navLinks: { id: string; label: string }[] = [
  { id: 'resume', label: 'About' },
  { id: 'work', label: 'AI in E-Commerce' },
  { id: 'workflow', label: 'D2C workflow' },
  { id: 'vibe', label: 'Vibe Coding' },
];
---

<header class="site-nav">
  <div class="site-nav__bar site-shell">
    <a class="site-nav__brand" href={homeHref}>
      <span class="site-nav__mark" aria-hidden="true"></span>
      <span class="site-nav__brand-text">Chen’s AI Exploration</span>
    </a>

    <nav class="site-nav__links" aria-label="主导航" data-site-nav-links>
      {
        navLinks.map((link, i) => (
          <a
            class:list={['site-nav__link', { 'is-active': !homeAnchors && i === 0 }]}
            href={`${prefix}#${link.id}`}
            data-section-id={link.id}
            aria-current={!homeAnchors && i === 0 ? 'true' : undefined}
          >
            <span class="site-nav__link-label">{link.label}</span>
          </a>
        ))
      }
    </nav>

    <a class="site-nav__cta" href={`${prefix}#contact`}>Contact me</a>
  </div>
</header>

<script>
  function initSiteNavTabs() {
    const nav = document.querySelector('[data-site-nav-links]');
    if (!nav) return;

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.site-nav__link'),
    );
    const sectionIds = links
      .map((link) => link.dataset.sectionId)
      .filter((id): id is string => Boolean(id));
    const nodes = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string | null) => {
      links.forEach((link) => {
        const active = Boolean(id) && link.dataset.sectionId === id;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    if (nodes.length === 0) {
      setActive(null);
      return;
    }

    if (sectionIds[0]) setActive(sectionIds[0]);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      {
        rootMargin: '-20% 0px -55% 0px',
        threshold: [0.1, 0.25, 0.5],
      },
    );
    nodes.forEach((node) => observer.observe(node));
  }

  initSiteNavTabs();
  document.addEventListener('astro:page-load', initSiteNavTabs);
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: var(--spacing-16) 0;
    background: var(--surface-pumice-canvas);
  }

  .site-nav__bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    background: var(--surface-limestone);
    border-radius: var(--radius-pills);
    padding: 9px 12px 9px 20px;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--color-ember);
  }

  .site-nav__brand:hover {
    color: var(--color-ember);
    opacity: 0.92;
  }

  .site-nav__mark {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--color-ember);
    flex-shrink: 0;
  }

  .site-nav__brand-text {
    font-family: 'PP Neue Corp', var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
    font-synthesis: none;
  }

  .site-nav__links {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: var(--radius-pills);
    text-decoration: none;
    white-space: nowrap;
    font-family: 'PP Neue Corp', var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-obsidian);
    font-synthesis: none;
  }

  .site-nav__link:hover {
    color: var(--color-ember);
  }

  .site-nav__link-label {
    position: relative;
    display: inline-block;
  }

  .site-nav__link.is-active .site-nav__link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-ember);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    gap: 8px;
    padding: 12px 24px;
    border-radius: var(--radius-pills);
    background: var(--color-ember);
    color: var(--color-chalk);
    text-decoration: none;
    white-space: nowrap;
    font-family: 'PP Neue Corp', var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    font-synthesis: none;
  }

  .site-nav__cta:hover {
    color: var(--color-chalk);
    opacity: 0.92;
  }

  @media (max-width: 900px) {
    .site-nav__links {
      display: none;
    }

    .site-nav__bar {
      justify-content: space-between;
    }
  }
</style>
